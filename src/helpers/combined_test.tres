[sub_resource type="Shader" id="Shader_24a71"]
code = "shader_type canvas_item;
render_mode blend_add;

#include \"res://src/shaders/_include/depth_base.gdshaderinc\"
#include \"res://src/shaders/_include/general_base.gdshaderinc\"
#include \"res://src/shaders/_include/linear_base.gdshaderinc\"

uniform float opacity : hint_range(0.0, 1.0, 0.1) = 1;
uniform sampler2D noise : repeat_enable;
uniform float rot_radians = 0;
uniform float ray_strength = 1.225;
uniform vec2  wave_stretch = vec2(1,1);

void vertex()
{
	UV = mat2( 
		vec2(cos(rot_radians), sin(rot_radians)), 
		vec2(-sin(rot_radians), cos(rot_radians)) ) * (UV / 2.);
	UV.x = UV.x * wave_stretch.x;
	UV.y = UV.y * wave_stretch.y;
}

void fragment()
{
 	vec2 uv = UV;
 	vec4 noise_scroll_fwd = texture(
		noise, 
		vec2(
			UV.x + (TIME * scroll_speed), 
			UV.y * .4)
		) * texture(noise, uv + vec2(TIME * scroll_speed));
	
	vec4 noise_scroll_back = texture(
		noise, 
		vec2(
			UV.x + -(TIME * scroll_speed / 1.2), 
			UV.y * .2)
		);
	vec4 wave_effect =  texture(
		TEXTURE, 
		uv + scroll_speed * vec2(noise_scroll_fwd.x,  noise_scroll_fwd.y));
	
	COLOR.rgb = (noise_scroll_fwd * noise_scroll_back).rgb * texture(gradient, UV * 2.).rgb  * wave_effect.rgb * ray_strength;
	COLOR.a = (wave_effect.a);
 
}
"

